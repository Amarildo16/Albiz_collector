# Local environment template. Copy this file to .env and edit local values.
# Do not commit .env.

# General runtime label. Loaded for diagnostics; no runtime branching currently.
APP_ENV=development

# Database connection used by the app and Alembic. No password is included here.
# Relative SQLite file URLs such as sqlite:///./local-dev.db resolve from the project root.
DATABASE_URL=mysql+pymysql://root@localhost/albiz_collector

# Raw artifact storage root. Relative paths resolve from the project root.
RAW_STORAGE_DIR=./data/raw

# HTTP client defaults for live collectors and smoke checks.
HTTP_TIMEOUT_SECONDS=30
HTTP_USER_AGENT=AlbizCollector/0.1 (+thesis-research; contact-yourself@example.com)

# APP procurement export defaults.
APP_EXPORT_YEARS=2010,2011,2012,2013,2014,2015,2016,2017,2018,2019,2020,2021,2022,2023,2024,2025,2026
# Reserved/currently inactive: loaded by config, not used by the collector today.
APP_DOWNLOAD_ENABLED=true

# Experimental QKB notices browser-assisted settings.
QKB_NOTICES_PLAYWRIGHT_HEADLESS=true
QKB_NOTICES_WAIT_MS=2500
QKB_NOTICES_SEARCH_BUTTON_TEXT=Kërko
QKB_NOTICES_PARSE_DOCUMENT_LINKS_ONLY=false
# Reserved/currently inactive: loaded by config for future selector-based notices runs.
QKB_NOTICES_DATE_FROM_SELECTOR=
QKB_NOTICES_DATE_TO_SELECTOR=

# QKB subject-search smoke-check selectors.
QKB_SEARCH_NIPT_SELECTOR=#nipt
QKB_SEARCH_DATE_FROM_SELECTOR=#dataNga
QKB_SEARCH_DATE_TO_SELECTOR=#dataNe

# Scheduler defaults.
SCHEDULER_APP_EXPORTS_HOUR=5
SCHEDULER_ENABLE_QKB_SEARCH=true
SCHEDULER_QKB_SEARCH_HOUR=6
SCHEDULER_QKB_SEARCH_LOOKBACK_DAYS=1
