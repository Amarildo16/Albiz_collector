APP_ENV=development
DATABASE_URL=mysql+pymysql://root@localhost/albiz_collector
RAW_STORAGE_DIR=./data/raw
HTTP_TIMEOUT_SECONDS=30
HTTP_USER_AGENT=AlbizCollector/0.1 (+thesis-research; contact-yourself@example.com)

APP_EXPORT_YEARS=2010,2011,2012,2013,2014,2015,2016,2017,2018,2019,2020,2021,2022,2023,2024,2025,2026
APP_DOWNLOAD_ENABLED=true

QKB_NOTICES_PLAYWRIGHT_HEADLESS=true
QKB_NOTICES_WAIT_MS=2500
QKB_NOTICES_SEARCH_BUTTON_TEXT=Kërko
QKB_NOTICES_PARSE_DOCUMENT_LINKS_ONLY=false

QKB_SEARCH_PLAYWRIGHT_HEADLESS=true
QKB_SEARCH_WAIT_MS=3000
QKB_SEARCH_NIPT_SELECTOR=#nipt
QKB_SEARCH_DATE_FROM_SELECTOR=#dataNga
QKB_SEARCH_DATE_TO_SELECTOR=#dataNe
QKB_SEARCH_BUTTON_TEXT=Kërko
QKB_NOTICES_DATE_FROM_SELECTOR=
QKB_NOTICES_DATE_TO_SELECTOR=

SCHEDULER_APP_EXPORTS_HOUR=5
SCHEDULER_QKB_NOTICES_INTERVAL_HOURS=6
SCHEDULER_QKB_SEARCH_HOUR=6
